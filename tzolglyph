ColName=(".col/blue" ".col/purple" ".col/red" ".col/underline" ".col/yellow" ".col/green")

TzlVar=$((TzlDay + 3))
Mov=$((TzlVar % 20))
MovDay=$(((TzlDay % 13) +1))

ThisMov="${MovName[Mov]}"

